# Microsoft Entra ID — API protegida
ENTRA_ISSUER=https://login.microsoftonline.com/1a1fed8a-8960-4a10-95a1-f9d77a98832a/v2.0
ENTRA_JWKS_URI=https://login.microsoftonline.com/1a1fed8a-8960-4a10-95a1-f9d77a98832a/discovery/v2.0/keys
ENTRA_AUDIENCE=d0b2e05c-58b9-4d02-aade-281d22bb3074
FRONTEND_ORIGINS=http://localhost:4200

# Base de datos del Compose
DB_NAME=pedidos360
DB_USER=pedidos360
DB_PASSWORD=change-this-before-deploying
DB_URL=jdbc:postgresql://database:5432/pedidos360

# RabbitMQ
RABBITMQ_ERLANG_COOKIE=replace-this-cookie
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBIT_ADDRESSES=rabbit-1:5672,rabbit-2:5672,rabbit-3:5672
RABBIT_MANAGEMENT_URL=http://rabbit-1:15672

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092,kafka-2:29092,kafka-3:29092
KAFKA_REPLICATION_FACTOR=3
KAFKA_ADVERTISED_HOST=localhost

# Publicaciones del proxy API; el API Gateway llega por EC2:80
API_PROXY_BIND=0.0.0.0
API_PROXY_PORT=80
HEALTH_BIND=127.0.0.1
HEALTH_PORT=3000
